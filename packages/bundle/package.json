{
  "name": "@dshr/bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The dshr terminal-surface bundle: patch layer over dsh-base, the startup flag provider, and the runtime glue plugin",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "profile-template"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@dshr/protocol": "workspace:*",
    "@dshr/surface": "workspace:*",
    "commander": "^15.0.0",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
